{
  "openapi": "3.1.0",
  "info": {
    "title": "Quran Kareem API",
    "version": "1.0.0",
    "description": "API for accessing the Holy Quran surahs, verses (ayahs), and metadata.",
    "contact": {
      "name": "Youssef Atef",
      "url": "https://quran-kareem-ya-21.vercel.app/"
    }
  },
  "servers": [
    {
      "url": "https://quran-kareem-ya-21.vercel.app",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns operational status of the service.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "quran-kareem" },
                    "version": { "type": "string", "example": "1.0.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Quran Kareem Web & Markdown Interface",
        "description": "Returns Quran Kareem interactive application or Markdown for AI agents when Accept: text/markdown header is provided.",
        "responses": {
          "200": {
            "description": "HTML or Markdown payload",
            "content": {
              "text/html": {},
              "text/markdown": {}
            }
          }
        }
      }
    }
  }
}

